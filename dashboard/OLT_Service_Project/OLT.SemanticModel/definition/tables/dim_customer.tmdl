	partition dim_customer = m
		mode: import
		source =
				let
				 Source = Csv.Document(File.Contents(DataRoot & "dim_customer.csv"),[Delimiter=",",Encoding=65001,QuoteStyle=QuoteStyle.Csv]),
				 Headers = Table.PromoteHeaders(Source,[PromoteAllScalars=true]),
				 Nulls = Table.ReplaceValue(Headers,"",null,Replacer.ReplaceValue,Table.ColumnNames(Headers)),
				 Typed = Table.TransformColumnTypes(Nulls,{{"customer_key", type text},{"customer_type", type text},{"connection_count", Int64.Type}},"en-US")
				in Typed

