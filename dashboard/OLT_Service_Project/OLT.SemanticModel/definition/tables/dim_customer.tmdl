table dim_customer
	lineageTag: ad152a9e-7e42-4daa-8fa3-2b685ebcf67b

	column customer_key
		dataType: string
		lineageTag: b55cda61-3b83-4555-b01d-592a14272e7a
		summarizeBy: none
		sourceColumn: customer_key

	column customer_type
		dataType: string
		lineageTag: 358cd828-5358-4483-b55b-3f0267056383
		summarizeBy: none
		sourceColumn: customer_type

	column connection_count
		dataType: int64
		lineageTag: 7928e578-6453-4c31-ba82-31d022a27492
		summarizeBy: none
