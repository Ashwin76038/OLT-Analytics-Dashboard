// Production measures. Store them in a dedicated display table named '_Measures'.
// Format rate/KPI measures as Percentage and monetary measures as INR currency.

Total Customers =
DISTINCTCOUNT ( 'Fact Customer Service'[customer_key] )

Active Customers =
VAR CustomersInScope = VALUES ( 'Fact Customer Service'[customer_key] )
RETURN
    COUNTROWS (
        FILTER (
            CustomersInScope,
            CALCULATE (
                COUNTROWS ( 'Fact Customer Service' ),
                REMOVEFILTERS ( 'Dim Service State' ),
                'Dim Service State'[is_revenue_generating] = 1
            ) > 0
        )
    )

Churned Customers =
VAR CustomersInScope = VALUES ( 'Fact Customer Service'[customer_key] )
RETURN
    COUNTROWS (
        FILTER (
            CustomersInScope,
            CALCULATE (
                COUNTROWS ( 'Fact Customer Service' ),
                REMOVEFILTERS ( 'Dim Service State' ),
                'Dim Service State'[is_revenue_generating] = 1
            ) = 0
                && CALCULATE (
                    COUNTROWS ( 'Fact Customer Service' ),
                    REMOVEFILTERS ( 'Dim Service State' ),
                    'Dim Service State'[service_status] = "inactive"
                ) > 0
        )
    )

Churn Rate =
DIVIDE ( [Churned Customers], [Total Customers] )

High Risk Customers =
CALCULATE (
    DISTINCTCOUNT ( 'Fact Customer Service'[customer_key] ),
    KEEPFILTERS ( 'Dim Service State'[risk_level] = "high" )
)

Revenue (MRR) =
CALCULATE (
    SUM ( 'Fact Customer Service'[monthly_fee] ),
    KEEPFILTERS ( 'Dim Service State'[is_revenue_generating] = 1 )
)

Revenue at Risk =
CALCULATE (
    SUM ( 'Fact Customer Service'[monthly_fee] ),
    KEEPFILTERS ( 'Dim Service State'[is_revenue_generating] = 1 ),
    KEEPFILTERS ( 'Dim Service State'[risk_level] = "high" )
)

OLT Performance KPI =
DIVIDE (
    SUMX (
        'Fact Customer Service',
        RELATED ( 'Dim Service State'[olt_performance_weight] )
    ),
    COUNTROWS ( 'Fact Customer Service' )
)

Downtime Impact =
CALCULATE (
    SUM ( 'Fact Customer Service'[monthly_fee] ),
    KEEPFILTERS (
        'Dim Service State'[network_quality_indicator]
            IN { "degraded_service_state", "disconnected" }
    )
)

ARPU =
DIVIDE ( [Revenue (MRR)], [Active Customers] )

Invalid Activation Records =
CALCULATE (
    COUNTROWS ( 'Fact Customer Service' ),
    REMOVEFILTERS ( 'Dim Date' ),
    'Fact Customer Service'[dq_future_activation_flag] = 1
        || 'Fact Customer Service'[dq_missing_activation_flag] = 1
)

Data Quality Review Records =
CALCULATE (
    COUNTROWS ( 'Fact Customer Service' ),
    REMOVEFILTERS ( 'Dim Date' ),
    'Fact Customer Service'[data_quality_flag] = "review"
)

// The supplied extract has no complaint fact or complaint-count field.
// BLANK prevents missing observations from being presented as measured zero.
Average Complaints per Customer =
BLANK ()

// Optional audit measure: uses the inactive raw-date relationship.
Customers by Reported Activation Date =
CALCULATE (
    [Total Customers],
    CROSSFILTER (
        'Dim Date'[date_key],
        'Fact Customer Service'[activation_date_key],
        NONE
    ),
    USERELATIONSHIP (
        'Dim Date'[date_key],
        'Fact Customer Service'[reported_activation_date_key]
    )
)
