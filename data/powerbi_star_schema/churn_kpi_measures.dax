// Legacy filename. Canonical measures are in the PBIP _Measures.tmdl.
// Executable reconciliation query: docs/validate_measures.dax.
'Service Records' = COUNTROWS(fact_customer_service)
'Customer Keys' = DISTINCTCOUNT(fact_customer_service[customer_key])
'OLT Groups' = DISTINCTCOUNT(fact_customer_service[olt_key])
'Active Services' = COALESCE(CALCULATE([Service Records],KEEPFILTERS(dim_service_state[service_status]="active")),0)
'Partial Services' = COALESCE(CALCULATE([Service Records],KEEPFILTERS(dim_service_state[service_status]="partial_active")),0)
'Inactive Services' = COALESCE(CALCULATE([Service Records],KEEPFILTERS(dim_service_state[service_status]="inactive")),0)
'Active Service Share' = DIVIDE([Active Services],[Service Records])
'Status Review Services' = [Partial Services]+[Inactive Services]
'Status Review Share' = DIVIDE([Status Review Services],[Service Records])
'Inactive Only Keys' = COALESCE(COUNTROWS(FILTER(VALUES(fact_customer_service[customer_key]),CALCULATE(COUNTROWS(fact_customer_service),REMOVEFILTERS(dim_service_state),dim_service_state[service_status] IN {"active","partial_active"})=0 && CALCULATE(COUNTROWS(fact_customer_service),REMOVEFILTERS(dim_service_state),dim_service_state[service_status]="inactive")>0)),0)
'Monthly Listed Exposure' = CALCULATE(SUM(fact_customer_service[monthly_fee]),KEEPFILTERS(dim_plan[plan_period]="MONTHLY"),KEEPFILTERS(dim_service_state[service_status] IN {"active","partial_active"}))
'Listed Exposure In Period' = IF(HASONEVALUE(dim_plan[plan_period]),CALCULATE(SUM(fact_customer_service[monthly_fee]),KEEPFILTERS(dim_service_state[service_status] IN {"active","partial_active"})),BLANK())
'Service State Index' = DIVIDE(SUMX(fact_customer_service,RELATED(dim_service_state[olt_performance_weight])),[Service Records])
'Date Withheld Records' = SUM(fact_customer_service[activation_date_withheld_flag])
'Legacy Future Dates' = SUM(fact_customer_service[legacy_prepared_future_activation_flag])
'Current Future Dates' = SUM(fact_customer_service[dq_future_activation_flag])
'Unknown Period Records' = SUM(fact_customer_service[dq_unknown_plan_period_flag])
'Quality Review Records' = COALESCE(CALCULATE([Service Records],KEEPFILTERS(fact_customer_service[data_quality_flag]="review")),0)
'Valid Tenure Records' = COUNT(fact_customer_service[valid_tenure_days])
