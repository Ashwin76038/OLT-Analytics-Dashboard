ROW("Check","OLT 1 Monthly / Current Future Dates","Passed",NOT ISBLANK(CALCULATE([Current Future Dates],TREATAS({"OLT_0001"},dim_olt[olt_key]),TREATAS({"MONTHLY"},dim_plan[plan_period]))) && ABS(CALCULATE([Current Future Dates],TREATAS({"OLT_0001"},dim_olt[olt_key]),TREATAS({"MONTHLY"},dim_plan[plan_period]))-(0))<0.0000001),
