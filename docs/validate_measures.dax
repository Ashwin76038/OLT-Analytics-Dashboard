ROW("Check","OLT 1 Monthly / Status Review Share","Passed",NOT ISBLANK(CALCULATE([Status Review Share],TREATAS({"OLT_0001"},dim_olt[olt_key]),TREATAS({"MONTHLY"},dim_plan[plan_period]))) && ABS(CALCULATE([Status Review Share],TREATAS({"OLT_0001"},dim_olt[olt_key]),TREATAS({"MONTHLY"},dim_plan[plan_period]))-(0.05188679245283019))<0.0000001),
ROW("Check","OLT 1 Monthly / Inactive Only Keys","Passed",NOT ISBLANK(CALCULATE([Inactive Only Keys],TREATAS({"OLT_0001"},dim_olt[olt_key]),TREATAS({"MONTHLY"},dim_plan[plan_period]))) && ABS(CALCULATE([Inactive Only Keys],TREATAS({"OLT_0001"},dim_olt[olt_key]),TREATAS({"MONTHLY"},dim_plan[plan_period]))-(6))<0.0000001),
ROW("Check","OLT 1 Monthly / Monthly Listed Exposure","Passed",NOT ISBLANK(CALCULATE([Monthly Listed Exposure],TREATAS({"OLT_0001"},dim_olt[olt_key]),TREATAS({"MONTHLY"},dim_plan[plan_period]))) && ABS(CALCULATE([Monthly Listed Exposure],TREATAS({"OLT_0001"},dim_olt[olt_key]),TREATAS({"MONTHLY"},dim_plan[plan_period]))-(1131925.0))<0.0000001),
ROW("Check","OLT 1 Monthly / Listed Exposure In Period","Passed",NOT ISBLANK(CALCULATE([Listed Exposure In Period],TREATAS({"OLT_0001"},dim_olt[olt_key]),TREATAS({"MONTHLY"},dim_plan[plan_period]))) && ABS(CALCULATE([Listed Exposure In Period],TREATAS({"OLT_0001"},dim_olt[olt_key]),TREATAS({"MONTHLY"},dim_plan[plan_period]))-(1131925.0))<0.0000001),
ROW("Check","OLT 1 Monthly / Service State Index","Passed",NOT ISBLANK(CALCULATE([Service State Index],TREATAS({"OLT_0001"},dim_olt[olt_key]),TREATAS({"MONTHLY"},dim_plan[plan_period]))) && ABS(CALCULATE([Service State Index],TREATAS({"OLT_0001"},dim_olt[olt_key]),TREATAS({"MONTHLY"},dim_plan[plan_period]))-(0.964622641509434))<0.0000001),
